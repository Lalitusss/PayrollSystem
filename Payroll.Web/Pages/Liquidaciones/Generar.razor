@page "/liquidaciones/generar"
@using Payroll.Services.DTOs
@inject HttpClient Http
@inject NavigationManager Navigation

<div class="container-fluid h-100 mt-2">
    @* --- CABECERA DE CONTROL (EL CUÁNDO) --- *@
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body py-2 bg-dark text-white rounded">
            <div class="row align-items-center">
                <div class="col-md-2">
                    <label class="small fw-bold text-uppercase opacity-75">Mes</label>
                    <select class="form-select form-select-sm bg-dark text-white border-secondary" @bind="MesSeleccionado">
                        <option value="1">Enero</option>
                        <option value="2">Febrero</option>
                        <option value="3">Marzo</option>
                        @* ... resto de meses ... *@
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="small fw-bold text-uppercase opacity-75">Año</label>
                    <select class="form-select form-select-sm bg-dark text-white border-secondary" @bind="AnioSeleccionado">
                        <option value="2025">2025</option>
                        <option value="2026">2026</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="small fw-bold text-uppercase opacity-75">Tipo</label>
                    <select class="form-select form-select-sm bg-dark text-white border-secondary" @bind="TipoLiquidacion">
                        <option value="1">Mensual Normal</option>
                        <option value="2">SAC (Aguinaldo)</option>
                        <option value="3">Vacaciones</option>
                    </select>
                </div>
                <div class="col text-end pt-3">
                    <span class="badge bg-warning text-dark me-2">ESTADO: BORRADOR</span>
                    <button class="btn btn-primary btn-sm fw-bold">
                        <i class="bi bi-plus-circle me-1"></i> NUEVA LIQUIDACIÓN
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="row h-100 g-3">
        @* --- COLUMNA 1: ALCANCE (QUIÉNES VAMOS A LIQUIDAR) --- *@
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-secondary text-white py-3">
                    <span class="fw-bold text-uppercase small">Seleccionar Grupo</span>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        <div class="list-group-item bg-light small fw-bold">POR CONVENIO</div>
                        @* Aquí iterarías tus convenios *@
                        <label class="list-group-item d-flex gap-2 pointer">
                            <input class="form-check-input" type="checkbox"> 
                            <span>Comercio (CCT 130/75)</span>
                        </label>
                        <label class="list-group-item d-flex gap-2 pointer">
                            <input class="form-check-input" type="checkbox"> 
                            <span>UOM</span>
                        </label>
                        
                        <div class="list-group-item bg-light small fw-bold mt-2">FILTRO INDIVIDUAL</div>
                        <div class="p-2">
                            <input type="text" class="form-control form-control-sm" placeholder="Buscar empleado..." />
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-white border-0">
                    <button class="btn btn-dark w-100 btn-sm">
                        <i class="bi bi-people-fill me-1"></i> CARGAR EMPLEADOS
                    </button>
                </div>
            </div>
        </div>

        @* --- COLUMNA 2: MONITOR DE CÁLCULO (EL MOTOR) --- *@
        <div class="col-md-9">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-info text-dark py-3 d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-uppercase small">Monitor de Liquidación</span>
                    <div>
                        <button class="btn btn-sm btn-success fw-bold shadow-sm">
                            <i class="bi bi-play-circle-fill me-1"></i> EJECUTAR CÁLCULO MASIVO
                        </button>
                    </div>
                </div>
                <div class="card-body p-0 scroll-column">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3 small">Empleado</th>
                                <th class="small">Convenio / Cargo</th>
                                <th class="small text-center">Estado</th>
                                <th class="small text-end">Haberes</th>
                                <th class="small text-end">Desc.</th>
                                <th class="small text-end">Neto</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @* Ejemplo de fila de empleado *@
                            <tr>
                                <td class="ps-3">
                                    <div class="fw-bold mb-0">Eduardo Tamayo</div>
                                    <small class="text-muted">Legajo: 1024</small>
                                </td>
                                <td>
                                    <div class="small">Comercio</div>
                                    <div class="badge bg-primary-subtle text-primary" style="font-size: 0.65rem;">VENDEDOR A</div>
                                </td>
                                <td class="text-center">
                                    <span class="badge rounded-pill bg-success-subtle text-success">Calculado</span>
                                </td>
                                <td class="text-end small fw-bold">$ 550.000,00</td>
                                <td class="text-end small text-danger">$ 93.500,00</td>
                                <td class="text-end small fw-bold text-primary">$ 456.500,00</td>
                                <td class="text-center">
                                    <button class="btn btn-sm text-primary" title="Ver Detalle de Conceptos">
                                        <i class="bi bi-calculator"></i>
                                    </button>
                                    <button class="btn btn-sm text-danger" title="Quitar de esta liquidación">
                                        <i class="bi bi-x-circle"></i>
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    
                    @* Estado vacío si no hay carga *@
                    <div class="text-center p-5 text-muted opacity-50">
                        <i class="bi bi-cpu fs-1 d-block mb-2"></i>
                        <p>Seleccione un grupo y cargue empleados para iniciar el cálculo.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .scroll-column { max-height: 70vh; overflow-y: auto; }
    .pointer { cursor: pointer; }
</style>

@code {
    private int MesSeleccionado = DateTime.Now.Month;
    private int AnioSeleccionado = DateTime.Now.Year;
    private int TipoLiquidacion = 1;
    
    // Aquí vendrá la lógica del motor
}