@page "/personas/nuevo"
@page "/personas/editar/{Id:int}"
@inherits BaseFormulario<PersonaEdicionDto>

<div class="container mt-4">
    <div class="mb-4">
        <button class="btn btn-link text-decoration-none p-0" @onclick="Cancelar">
            <i class="bi bi-arrow-left"></i> Volver a la lista
        </button>
        <h3 class="fw-bold mt-2">
            @(Id == 0 ? "Nuevo Legajo" : $"Editar Legajo: {Modelo.Apellido}, {Modelo.Nombre}")
        </h3>
    </div>

    @* Navegación de Solapas *@
    <ul class="nav nav-tabs mb-0">
        <li class="nav-item">
            <button class="nav-link @(tabActiva == "general" ? "active" : "")" @onclick='() => SeleccionarTab("general")'>General</button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(tabActiva == "direccion" ? "active" : "")" @onclick='() => SeleccionarTab("direccion")'>Dirección</button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(tabActiva == "banco" ? "active" : "")" @onclick='() => SeleccionarTab("banco")'>Banco</button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(tabActiva == "familia" ? "active" : "")" @onclick='() => SeleccionarTab("familia")'>Familiares</button>
        </li>
    </ul>

    <div class="tab-content card shadow-sm p-4 border-top-0" style="border-radius: 0 0 .375rem .375rem;">
        
        @if (tabActiva == "general")
        {
            <div class="row g-3">
                <div class="col-md-6"><label class="fw-bold">Nombre</label><input @bind="Modelo.Nombre" class="form-control" /></div>
                <div class="col-md-6"><label class="fw-bold">Apellido</label><input @bind="Modelo.Apellido" class="form-control" /></div>
                <div class="col-md-4"><label class="fw-bold">DNI</label><input @bind="Modelo.DNI" class="form-control" /></div>
                <div class="col-md-4"><label class="fw-bold">CUIL</label><input @bind="Modelo.CUIL" class="form-control" placeholder="00-00000000-0" /></div>
                <div class="col-md-4"><label class="fw-bold">Email</label><input @bind="Modelo.Email" class="form-control" /></div>
                <div class="col-md-4"><label class="fw-bold">Fecha Ingreso</label><input type="date" @bind="Modelo.FechaIngreso" class="form-control" /></div>
                <div class="col-md-8">
                    <label class="fw-bold">Obra Social</label>
                    <select class="form-select" @bind="Modelo.ObraSocialId">
                        <option value="">-- Seleccione Obra Social --</option>
                        @foreach (var os in obrasSociales)
                        {
                            <option value="@os.Id">@os.Nombre</option>
                        }
                    </select>
                </div>
            </div>
        }

        @if (tabActiva == "direccion")
        {
            <div class="row g-3">
                <div class="col-md-6"><label class="fw-bold">Calle</label><input @bind="Modelo.DireccionCalle" class="form-control" /></div>
                <div class="col-md-2"><label class="fw-bold">Altura</label><input @bind="Modelo.DireccionAltura" class="form-control" /></div>
                <div class="col-md-2"><label class="fw-bold">Piso</label><input @bind="Modelo.DireccionPiso" class="form-control" /></div>
                <div class="col-md-2"><label class="fw-bold">Depto</label><input @bind="Modelo.DireccionDepto" class="form-control" /></div>
                <div class="col-md-4"><label class="fw-bold">Localidad</label><input @bind="Modelo.DireccionLocalidad" class="form-control" /></div>
                <div class="col-md-4">
                    <label class="fw-bold">Provincia</label>
                    <select class="form-select" @bind="Modelo.DireccionProvinciaId">
                        <option value="0">-- Seleccione Provincia --</option>
                        @foreach (var p in provincias)
                        {
                            <option value="@p.Id">@p.Nombre</option>
                        }
                    </select>
                </div>
            </div>
        }

        @if (tabActiva == "banco")
        {
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="fw-bold">Banco</label>
                    <select class="form-select" @bind="Modelo.DatoBancarioBancoId">
                        <option value="0">-- Seleccione Banco --</option>
                        @foreach (var b in bancos)
                        {
                            <option value="@b.Id">@b.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-md-6"><label class="fw-bold">CBU (22 dígitos)</label><input @bind="Modelo.DatoBancarioCBU" class="form-control" maxlength="22" /></div>
                <div class="col-md-6"><label class="fw-bold">Alias</label><input @bind="Modelo.DatoBancarioAlias" class="form-control" /></div>
            </div>
        }

        @if (tabActiva == "familia")
        {
            <div class="text-end mb-3">
                <button class="btn btn-outline-success btn-sm" @onclick="AgregarFamiliar">
                    <i class="bi bi-person-plus me-1"></i> Agregar Familiar
                </button>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Nombre</th>
                            <th>Apellido</th>
                            <th>DNI</th>
                            <th>Parentesco</th>
                            <th class="text-center">A Cargo</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in Modelo.Familiar)
                        {
                            <tr>
                                <td><input @bind="f.Nombre" class="form-control form-control-sm" /></td>
                                <td><input @bind="f.Apellido" class="form-control form-control-sm" /></td>
                                <td><input @bind="f.DNI" class="form-control form-control-sm" /></td>
                                <td>
                                    <select @bind="f.Parentesco" class="form-select form-select-sm">
                                        <option value="1">Hijo/a</option>
                                        <option value="2">Cónyuge</option>
                                        <option value="3">Otro</option>
                                    </select>
                                </td>
                                <td class="text-center"><input type="checkbox" @bind="f.ACargo" class="form-check-input" /></td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-light border text-danger" @onclick="() => Modelo.Familiar.Remove(f)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="text-end mt-4 pt-3 border-top">
            <button class="btn btn-light me-2" @onclick="Cancelar">Cancelar</button>
            <button class="btn btn-primary px-5" @onclick="Guardar">
                <i class="bi bi-save me-2"></i> Guardar
            </button>
        </div>
    </div>
</div>

@code {
    protected override string ApiUrl => "personas";
    protected override string PageUrl => "/personas";

    private string tabActiva = "general";
    private void SeleccionarTab(string nombreTab) => tabActiva = nombreTab;

    private List<BancoDto> bancos = new();
    private List<ObraSocialDto> obrasSociales = new();
    private List<ProvinciaDto> provincias = new();

    protected override async Task OnInitializedAsync()
    {
        // Cargamos catálogos usando DTOs livianos
        bancos = await Http.GetFromJsonAsync<List<BancoDto>>("api/bancos") ?? new();
        obrasSociales = await Http.GetFromJsonAsync<List<ObraSocialDto>>("api/obrassociales") ?? new();
        provincias = await Http.GetFromJsonAsync<List<ProvinciaDto>>("api/provincias") ?? new();
        
        await base.OnInitializedAsync();
    }

    private void AgregarFamiliar() => Modelo.Familiar.Add(new FamiliarDto { PersonaId = Modelo.Id });
}