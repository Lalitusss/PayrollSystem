@page "/configuracion/cargos/nuevo"
@page "/configuracion/cargos/editar/{Id:int}"
@inherits BaseFormulario<CargoDto>

<div class="mb-4">
    <button class="btn btn-link text-decoration-none p-0" @onclick="Cancelar">
        <i class="bi bi-arrow-left"></i> Volver a la lista
    </button>
    <h3 class="fw-bold mt-2">@(Id == 0 ? "Nuevo Cargo" : $"Editar Cargo: {Modelo.Nombre}")</h3>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-4">
        <div class="row g-3">
            <div class="col-md-7">
                <label class="form-label fw-bold">Nombre del Cargo</label>
                <input type="text" class="form-control"
                       @bind="Modelo.Nombre"
                       @bind:event="oninput"
                       placeholder="Ej: Administrativo Especializado" />
            </div>
        </div>

        <div class="text-end mt-4">
            <button class="btn btn-light me-2" @onclick="Cancelar">Cancelar</button>
            <button class="btn btn-primary px-5"
                    @onclick="GuardarCargo"
                    disabled="@(!HuboCambios())">
                <i class="bi bi-save me-2"></i> Guardar
            </button>
        </div>
    </div>
</div>

@* --- LISTA DE CATEGORÍAS ASOCIADAS --- *@
@if (Id != 0)
{
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 border-bottom-0 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0 text-primary">Categorías del Cargo</h5>
            <a href="/configuracion/categorias/nuevo" class="btn btn-sm btn-primary">
                <i class="bi bi-plus-lg me-1"></i> Nueva Categoría
            </a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Nombre de Categoría</th>
                            <th class="text-end">Sueldo Básico</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                  
                </table>
            </div>
        </div>
    </div>
}

@code {
    protected override string ApiUrl => "cargos";
    protected override string PageUrl => "/configuracion/cargos";

    private List<ConvenioDto>? convenios;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Usamos DTO para los convenios también
            convenios = await Http.GetFromJsonAsync<List<ConvenioDto>>("api/convenios");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar convenios: {ex.Message}");
        }

        // Importante llamar a la base para que cargue el Modelo (CargoDto)
        await base.OnInitializedAsync();
    }

    private async Task GuardarCargo()
    {
 
        await base.Guardar();
    }
}