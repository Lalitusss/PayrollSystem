@page "/configuracion/tiposconceptos"
@inherits BaseListado<TipoConceptoDto>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-dark">Tipos de Conceptos</h2>
    <button class="btn btn-primary shadow-sm" @onclick="IrANuevo">
        <i class="bi bi-plus-circle me-2"></i> Nuevo Tipo
    </button>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Nombre del Tipo</th>
                        <th class="text-center">Color Identificador</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Lista == null)
                    {
                        <tr>
                            <td colspan="3" class="text-center py-5">
                                <div class="spinner-border text-primary spinner-border-sm" role="status"></div>
                                <span class="ms-2">Cargando tipos...</span>
                            </td>
                        </tr>
                    }
                    else if (!Lista.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center py-5 text-muted">
                                No hay tipos de conceptos definidos.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var t in Lista)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold">@t.Nombre</td>
                                <td class="text-center">
                                    <div class="d-flex align-items-center justify-content-center gap-2">
                                        <div class="shadow-sm"
                                             style="width: 20px; height: 20px; border-radius: 4px; background-color: @t.ColorHex; border: 1px solid #dee2e6">
                                        </div>
                                        <span class="text-muted fw-mono small">
                                            @t.ColorHex?.ToUpper()
                                        </span>
                                    </div>
                                </td>
                                <td class="text-end pe-4">
                                    <button class="btn btn-sm btn-light border me-1" @onclick="() => IrAEditar(t.Id)">
                                        <i class="bi bi-pencil text-primary"></i>
                                    </button>
                                    <button class="btn btn-sm btn-light border" @onclick="() => Eliminar(t.Id)">
                                        <i class="bi bi-trash text-danger"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    protected override string EntityName => "tiposconceptos";
    protected override string PageUrl => "/configuracion/tiposconceptos";
}