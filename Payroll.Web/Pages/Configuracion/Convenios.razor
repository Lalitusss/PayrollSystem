@page "/configuracion/convenios"
@using Payroll.Core.DTOs
@using System.Threading
@inherits BaseListado<ConvenioDto>
@implements IDisposable
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="container-fluid h-100 mt-2">
    <div class="row h-100 g-3">

        @* COLUMNA 1: CONVENIOS *@
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
                    <span class="fw-bold text-uppercase small">Convenios</span>
                    <button class="btn btn-outline-light rounded-circle d-flex align-items-center justify-content-center"
                            style="width: 28px; height: 28px; padding: 0;" @onclick="IrANuevo">
                        <i class="bi bi-plus-lg" style="font-size: 0.8rem;"></i>
                    </button>
                </div>
                <div class="list-group list-group-flush scroll-column">
                    @if (Lista != null)
                    {
                        @foreach (var c in Lista)
                        {
                            <button @onclick="() => SeleccionarConvenio(c)"
                                    class="list-group-item list-group-item-action border-start-0 border-end-0 py-2 @(ConvenioSeleccionado?.Id == c.Id ? "active bg-primary text-white" : "")">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="fw-medium">@c.Nombre</span>
                                    <span class="badge @(ConvenioSeleccionado?.Id == c.Id ? "bg-light text-primary" : "bg-secondary-subtle text-secondary")">@c.Numero</span>
                                </div>
                            </button>
                        }
                    }
                </div>
            </div>
        </div>

        @* COLUMNA 2: CATEGORÍAS Y CARGOS *@
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-secondary text-white py-3 d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-uppercase small">Categorías y Cargos</span>
                    @if (ConvenioSeleccionado != null)
                    {
                        <button class="btn btn-outline-light rounded-circle d-flex align-items-center justify-content-center"
                                style="width: 28px; height: 28px; padding: 0;" @onclick="NuevaCategoria">
                            <i class="bi bi-plus-lg" style="font-size: 0.8rem;"></i>
                        </button>
                    }
                </div>
                <div class="card-body p-0 scroll-column d-flex flex-column">
                    @if (ConvenioSeleccionado == null)
                    {
                        <div class="text-center my-auto p-4 animate-fade-in">
                            <i class="bi bi-arrow-left-circle text-muted mb-3" style="font-size: 2.5rem; opacity: 0.5;"></i>
                            <p class="text-muted small fw-bold">Seleccione un convenio para ver sus categorías</p>
                        </div>
                    }
                    else if (CargandoCategorias)
                    {
                        <div class="text-center my-auto"><div class="spinner-border text-secondary" role="status"></div></div>
                    }
                    else if (!CategoriasDelConvenio.Any())
                    {
                        <div class="text-center my-auto p-4 animate-fade-in">
                            <i class="bi bi-plus-circle text-secondary mb-3" style="font-size: 2.5rem; opacity: 0.4;"></i>
                            <p class="text-muted mb-3">No hay categorías configuradas para este convenio.</p>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="NuevaCategoria">
                                <i class="bi bi-plus-lg me-1"></i> Crear primera categoría
                            </button>
                        </div>
                    }
                    else
                    {
                        @foreach (var cat in CategoriasDelConvenio)
                        {
                            var estaAbierto = CategoriaAbiertaId == cat.Id;
                            var cantidadCargos = cat.Cargos?.Count ?? 0;
                            <div class="categoria-group border-bottom">
                                <div class="bg-light px-3 py-2 d-flex justify-content-between align-items-center pointer"
                                     @onclick="() => ToggleCategoria(cat.Id)">
                                    <div class="d-flex align-items-center">
                                        <i class="bi @(estaAbierto ? "bi-chevron-down" : "bi-chevron-right") me-2 text-muted" style="font-size: 0.7rem;"></i>
                                        <h6 class="text-dark small fw-bold mb-0 text-uppercase">
                                            @cat.Nombre
                                            <span class="badge rounded-pill bg-secondary ms-2" style="font-size: 0.6rem;">@cantidadCargos</span>
                                        </h6>
                                    </div>
                                    <button class="btn btn-sm text-primary p-0" @onclick:stopPropagation="true" @onclick="() => AbrirNuevoCargo(cat)">
                                        <i class="bi bi-plus-circle-fill"></i>
                                    </button>
                                </div>
                                @if (estaAbierto)
                                {
                                    <div class="list-group list-group-flush animate-fade-in">
                                        @foreach (var cargo in cat.Cargos ?? Enumerable.Empty<CargoDto>())
                                        {
                                            <div @onclick="() => SeleccionarCargo(cargo)"
                                                 class="list-group-item list-group-item-action py-2 ps-4 border-0 d-flex justify-content-between align-items-center @(CargoSeleccionado?.Id == cargo.Id ? "bg-primary-subtle fw-bold border-start border-primary border-4" : "small text-muted")"
                                                 style="cursor:pointer">

                                                <div class="flex-grow-1">
                                                    <span class="d-block">@cargo.Nombre</span>
                                                    <span class="text-primary" style="font-size: 0.7rem;">$ @cargo.SueldoBasico.ToString("N2")</span>
                                                </div>

                                                <div class="btn-group">
                                                    <button class="btn btn-sm text-secondary p-1" @onclick:stopPropagation="true" @onclick="() => AbrirEditarCargo(cargo)">
                                                        <i class="bi bi-pencil-square"></i>
                                                    </button>
                                                    <button class="btn btn-sm text-danger p-1" @onclick:stopPropagation="true" @onclick="() => EliminarCargo(cargo)">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        @* COLUMNA 3: CONCEPTOS VINCULADOS *@
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-info text-white py-3 d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-dark text-uppercase small">Conceptos Vinculados</span>
                    @if (ConvenioSeleccionado != null)
                    {
                        <button class="btn btn-dark rounded-circle d-flex align-items-center justify-content-center"
                                style="width: 28px; height: 28px; padding: 0;" @onclick="AbrirModalVinculacion">
                            <i class="bi bi-plus-lg" style="font-size: 0.8rem;"></i>
                        </button>
                    }
                </div>
                <div class="card-body p-0 d-flex flex-column">
                    @if (ConvenioSeleccionado == null)
                    {
                        <div class="text-center my-auto p-5 animate-fade-in">
                            <div class="mb-3">
                                <i class="bi bi-layers text-info" style="font-size: 3rem; opacity: 0.3;"></i>
                            </div>
                            <h5 class="text-muted fw-light">Configuración de Conceptos</h5>
                            <p class="text-muted small">Seleccione un convenio o cargo para gestionar sus fórmulas y conceptos</p>
                        </div>
                    }
                    else
                    {
                        <div class="bg-success text-white p-2 text-center small fw-bold text-uppercase">
                            @(CargoSeleccionado != null ? $"Cargo: {CargoSeleccionado.Nombre}" : $"General del Convenio: {ConvenioSeleccionado.Nombre}")
                        </div>

                        <div class="p-0 scroll-column flex-grow-1">
                            @if (CargandoConceptos)
                            {
                                <div class="text-center mt-5"><div class="spinner-border spinner-border-sm text-primary"></div></div>
                            }
                            else if (!ConceptosVinculados.Any())
                            {
                                <div class="text-center my-auto p-4">
                                    <i class="bi bi-exclamation-circle text-warning mb-2" style="font-size: 2rem;"></i>
                                    <p class="text-muted small">No hay conceptos vinculados aún.</p>
                                    <button class="btn btn-sm btn-outline-primary mt-2" @onclick="AbrirModalVinculacion">Vincular ahora</button>
                                </div>
                            }
                            else
                            {
                                <table class="table table-sm table-hover mb-0">
                                    <thead class="bg-light sticky-top">
                                        <tr>
                                            <th class="ps-3 small">Código</th>
                                            <th class="small">Concepto</th>
                                            <th class="small text-center">Tipo</th>
                                            <th class="small text-center">Origen</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var v in ConceptosVinculados)
                                        {
                                            <tr class="align-middle">
                                                <td class="ps-3 small text-muted">@v.Codigo</td>
                                                <td><div class="fw-bold small">@v.Descripcion</div></td>
                                                <td class="text-center small">@v.Tipo</td>
                                                <td class="text-center">
                                                    @if (v.CargoId == 0 || v.CargoId == null)
                                                    {
                                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary" style="font-size: 0.6rem;">CONVENIO</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-primary-subtle text-primary border border-primary" style="font-size: 0.6rem;">CARGO</span>
                                                    }
                                                </td>
                                                <td class="text-end pe-3">
                                                    @if (CargoSeleccionado == null && (v.CargoId == 0 || v.CargoId == null))
                                                    {
                                                        <button class="btn btn-sm text-danger" @onclick="() => EliminarVinculo(v)">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    }
                                                    else if (CargoSeleccionado != null && v.CargoId == CargoSeleccionado.Id)
                                                    {
                                                        <button class="btn btn-sm text-danger" @onclick="() => EliminarVinculo(v)">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-lock-fill text-muted small" title="Este concepto viene del convenio y no puede borrarse desde el cargo"></i>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@* --- MODALES --- *@
<ModalGenerico Titulo="Nuevo Convenio" Mostrar="mostrarModalConvenio" Cargando="procesando" OnCancelar="() => mostrarModalConvenio = false" OnConfirmar="GuardarConvenio">
    <div class="col-12">
        <label class="form-label small fw-bold">Nombre del Convenio</label>
        <input type="text" class="form-control" @bind="nuevoConvenio.Nombre" />
    </div>
    <div class="col-12">
        <label class="form-label small fw-bold">Número</label>
        <input type="text" class="form-control" @bind="nuevoConvenio.Numero" />
    </div>
</ModalGenerico>

<ModalGenerico Titulo="@($"Nueva Categoría para {ConvenioSeleccionado?.Nombre}")" Mostrar="mostrarModalCategoria" Cargando="procesando" OnCancelar="() => mostrarModalCategoria = false" OnConfirmar="GuardarCategoria">
    <div class="col-12">
        <label class="form-label small fw-bold">Nombre de la Categoría</label>
        <input type="text" class="form-control" @bind="nuevaCategoria.Nombre" />
    </div>
</ModalGenerico>

<ModalGenerico Titulo="@(cargoParaEditar.Id == 0 ? "Nuevo Cargo" : "Editar Cargo")" Mostrar="mostrarModalCargo" Cargando="procesando" OnCancelar="() => mostrarModalCargo = false" OnConfirmar="GuardarCargo">
    <div class="col-12">
        <label class="form-label small fw-bold text-uppercase" style="font-size: 0.7rem;">Nombre del Cargo</label>
        <input type="text" class="form-control form-control-sm" @bind="cargoParaEditar.Nombre" />
    </div>
    <div class="col-12">
        <label class="form-label small fw-bold text-uppercase" style="font-size: 0.7rem;">Sueldo Básico</label>
        <div class="input-group input-group-sm">
            <span class="input-group-text">$</span>
            <input type="number" class="form-control" @bind="cargoParaEditar.SueldoBasico" step="0.01" />
        </div>
    </div>
</ModalGenerico>

<ModalGenerico Titulo="Vincular Conceptos Maestros" Mostrar="mostrarModalVinculacion" Cargando="procesando" OnCancelar="() => mostrarModalVinculacion = false" OnConfirmar="GuardarVinculos">
    <div class="col-12">
        <div class="list-group shadow-sm scroll-column" style="max-height: 350px;">
            @foreach (var c in MaestroConceptos)
            {
                <label class="list-group-item d-flex gap-3 pointer">
                    <input class="form-check-input flex-shrink-0" type="checkbox" @bind="c.Seleccionado">
                    <span class="pt-1 small">
                        <strong>@c.Nombre</strong> - <span class="text-muted">@c.TipoConcepto</span>
                    </span>
                </label>
            }
        </div>
    </div>
</ModalGenerico>

<style>
    .scroll-column {
        max-height: 80vh;
        overflow-y: auto;
    }

    .pointer {
        cursor: pointer;
    }

    .animate-fade-in {
        animation: fadeIn 0.2s ease-in;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-5px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

@code {
    private ConvenioDto? ConvenioSeleccionado;
    private List<CategoriaDto> CategoriasDelConvenio = new();
    private CargoDto? CargoSeleccionado;
    private bool CargandoCategorias = false;
    private bool CargandoConceptos = false;
    private int? CategoriaAbiertaId;
    private CancellationTokenSource? cts;

    private List<ConceptoDto> ConceptosVinculados = new();
    private List<ConceptoSeleccionableDto> MaestroConceptos = new();

    private bool mostrarModalConvenio = false;
    private bool mostrarModalCategoria = false;
    private bool mostrarModalCargo = false;
    private bool mostrarModalVinculacion = false;
    private bool procesando = false;

    private ConvenioDto nuevoConvenio = new();
    private CategoriaDto nuevaCategoria = new();
    private CargoDto cargoParaEditar = new();

    protected override string PageUrl => "/configuracion/convenios";

    // 1. ANULAMOS el disparo automático de la base
    protected override Task OnParametersSetAsync()
    {
        // Al no llamar a base.OnParametersSetAsync(), evitamos el disparo de Cargar()
        return Task.CompletedTask;
    }

    // 2. Usamos SOLO nuestro método de carga
    protected override async Task OnInitializedAsync()
    {
        await CargarListaOptimizada();
    }
    private async Task CargarListaOptimizada()
    {
        try
        {
            Lista = await Http.GetFromJsonAsync<List<ConvenioDto>>("api/convenios/optimizado");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar convenios: {ex.Message}");
        }
    }

    private void ToggleCategoria(int id) => CategoriaAbiertaId = CategoriaAbiertaId == id ? null : id;

    private async Task SeleccionarConvenio(ConvenioDto c)
    {
        // Cancelación segura de peticiones anteriores
        cts?.Cancel();
        cts?.Dispose();
        cts = new CancellationTokenSource();
        var token = cts.Token;

        ConvenioSeleccionado = c;
        CargoSeleccionado = null;
        CargandoCategorias = true;
        CargandoConceptos = true;
        CategoriasDelConvenio.Clear();
        ConceptosVinculados.Clear();

        try
        {
            // Tarea 1: Categorías
            var tCategorias = Http.GetFromJsonAsync<List<CategoriaDto>>($"api/categorias/convenio/{c.Id}", token);
            // Tarea 2: Conceptos (Columna 3)
            var tConceptos = CargarConceptosColumna3(token);

            await Task.WhenAll(tCategorias, tConceptos);

            CategoriasDelConvenio = await tCategorias ?? new();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            Console.WriteLine($"Error en selección: {ex.Message}");
        }
        finally
        {
            if (!token.IsCancellationRequested)
            {
                CargandoCategorias = false;
                CargandoConceptos = false;
                StateHasChanged();
            }
        }
    }

    private async Task SeleccionarCargo(CargoDto cargo)
    {
        if (CargoSeleccionado?.Id == cargo.Id) return;

        CargoSeleccionado = cargo;
        await CargarConceptosColumna3();
    }

    private async Task CargarConceptosColumna3(CancellationToken token = default)
    {
        if (ConvenioSeleccionado == null) return;
        CargandoConceptos = true;

        try
        {
            // Cargar conceptos base del convenio
            string urlConvenio = $"api/VinculosConceptos/convenio/{ConvenioSeleccionado.Id}/cargo/0";
            var conceptosConvenio = await Http.GetFromJsonAsync<List<ConceptoDto>>(urlConvenio, token) ?? new();

            if (CargoSeleccionado != null)
            {
                // Cargar conceptos específicos del cargo
                string urlCargo = $"api/VinculosConceptos/convenio/{ConvenioSeleccionado.Id}/cargo/{CargoSeleccionado.Id}";
                var conceptosCargo = await Http.GetFromJsonAsync<List<ConceptoDto>>(urlCargo, token) ?? new();

                // Unificar evitando duplicados por Id (priorizando visualmente el origen)
                ConceptosVinculados = conceptosConvenio
                    .Concat(conceptosCargo)
                    .DistinctBy(x => x.Id)
                    .ToList();
            }
            else
            {
                ConceptosVinculados = conceptosConvenio;
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando conceptos: {ex.Message}");
        }
        finally
        {
            if (!token.IsCancellationRequested) CargandoConceptos = false;
        }
    }

    private async Task AbrirModalVinculacion()
    {
        if (ConvenioSeleccionado == null) return;
        procesando = true;
        try
        {
            var maestroOriginal = await Http.GetFromJsonAsync<List<ConceptoSeleccionableDto>>("api/VinculosConceptos/maestro") ?? new();
            var idsYaVinculados = ConceptosVinculados.Select(v => v.Id).ToList();

            // Solo mostrar conceptos que no están vinculados
            MaestroConceptos = maestroOriginal
                .Where(m => !idsYaVinculados.Contains(m.Id))
                .ToList();

            mostrarModalVinculacion = true;
        }
        finally { procesando = false; }
    }

    private async Task GuardarVinculos()
    {
        var seleccionados = MaestroConceptos.Where(x => x.Seleccionado).ToList();
        if (ConvenioSeleccionado == null || !seleccionados.Any()) return;

        procesando = true;
        try
        {
            var command = new
            {
                ConceptoIds = seleccionados.Select(x => x.Id).ToList(),
                ConvenioId = ConvenioSeleccionado.Id,
                CargoId = CargoSeleccionado?.Id ?? 0
            };

            var response = await Http.PostAsJsonAsync("api/VinculosConceptos/vincular", command);
            if (response.IsSuccessStatusCode)
            {
                mostrarModalVinculacion = false;
                await CargarConceptosColumna3();
            }
        }
        finally { procesando = false; }
    }

    private void IrANuevo() { nuevoConvenio = new(); mostrarModalConvenio = true; }

    private void NuevaCategoria()
    {
        if (ConvenioSeleccionado != null)
        {
            nuevaCategoria = new() { ConvenioId = ConvenioSeleccionado.Id };
            mostrarModalCategoria = true;
        }
    }

    private void AbrirNuevoCargo(CategoriaDto cat)
    {
        cargoParaEditar = new CargoDto { CategoriaId = cat.Id, SueldoBasico = 0 };
        mostrarModalCargo = true;
    }

    private void AbrirEditarCargo(CargoDto cargo)
    {
        cargoParaEditar = new CargoDto
        {
            Id = cargo.Id,
            Nombre = cargo.Nombre,
            SueldoBasico = cargo.SueldoBasico,
            CategoriaId = cargo.CategoriaId
        };
        mostrarModalCargo = true;
    }

    private async Task GuardarCargo()
    {
        if (string.IsNullOrWhiteSpace(cargoParaEditar.Nombre)) return;
        procesando = true;
        try
        {
            HttpResponseMessage response = cargoParaEditar.Id == 0
                ? await Http.PostAsJsonAsync("api/cargos", cargoParaEditar)
                : await Http.PutAsJsonAsync($"api/cargos/{cargoParaEditar.Id}", cargoParaEditar);

            if (response.IsSuccessStatusCode)
            {
                mostrarModalCargo = false;
                if (ConvenioSeleccionado != null) await SeleccionarConvenio(ConvenioSeleccionado);
            }
        }
        finally { procesando = false; }
    }

    private async Task EliminarCargo(CargoDto cargo)
    {
        if (await Confirmar("¿Eliminar Cargo?", $"Vas a borrar '{cargo.Nombre}'"))
        {
            var response = await Http.DeleteAsync($"api/cargos/{cargo.Id}");
            if (response.IsSuccessStatusCode)
            {
                await NotificarSuccess("Cargo eliminado");
                if (ConvenioSeleccionado != null) await SeleccionarConvenio(ConvenioSeleccionado);
            }
        }
    }

    private async Task GuardarConvenio()
    {
        if (string.IsNullOrEmpty(nuevoConvenio.Nombre)) return;
        procesando = true;
        var res = await Http.PostAsJsonAsync("api/convenios", nuevoConvenio);
        if (res.IsSuccessStatusCode)
        {
            mostrarModalConvenio = false;
            await CargarListaOptimizada();
            await NotificarSuccess("Convenio creado");
        }
        procesando = false;
    }

    private async Task GuardarCategoria()
    {
        if (string.IsNullOrEmpty(nuevaCategoria.Nombre) || ConvenioSeleccionado == null) return;
        nuevaCategoria.ConvenioId = ConvenioSeleccionado.Id;
        procesando = true;
        var res = await Http.PostAsJsonAsync("api/categorias", nuevaCategoria);
        if (res.IsSuccessStatusCode)
        {
            mostrarModalCategoria = false;
            await SeleccionarConvenio(ConvenioSeleccionado);
        }
        procesando = false;
    }

    private async Task EliminarVinculo(ConceptoDto v)
    {
        if (await Confirmar("¿Desvincular?", $"¿Quitar '{v.Descripcion}'?"))
        {
            var response = await Http.DeleteAsync($"api/VinculosConceptos/{v.VinculoConceptoId}");
            if (response.IsSuccessStatusCode)
            {
                await NotificarSuccess("Concepto desvinculado");
                await CargarConceptosColumna3();
            }
        }
    }

    public void Dispose()
    {
        cts?.Cancel();
        cts?.Dispose();
    }
}