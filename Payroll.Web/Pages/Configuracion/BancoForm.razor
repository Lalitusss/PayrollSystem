@page "/configuracion/bancos/nuevo"
@page "/configuracion/bancos/editar/{Id:int}"
@inherits BaseFormulario<BancoDto>

<div class="mb-4">
    <button class="btn btn-link text-decoration-none p-0" @onclick="Cancelar">
        <i class="bi bi-arrow-left"></i> Volver a la lista
    </button>
    <h3 class="fw-bold mt-2">@(Id == 0 ? "Nuevo Banco" : "Editar Banco")</h3>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label fw-bold">Código (BCRA)</label>
                @* Agregamos bind:event="oninput" *@
                <input type="text" class="form-control" 
                       @bind="Modelo.Codigo" 
                       @bind:event="oninput" 
                       placeholder="Ej: 072" />
            </div>
            <div class="col-md-9">
                <label class="form-label fw-bold">Nombre del Banco</label>
                @* Agregamos bind:event="oninput" *@
                <input type="text" class="form-control" 
                       @bind="Modelo.Nombre" 
                       @bind:event="oninput" />
            </div>
        </div>
        <div class="text-end mt-4">
            <button class="btn btn-light me-2" @onclick="Cancelar">Cancelar</button>
            <button class="btn btn-primary px-5" @onclick="Guardar" disabled="@(!HuboCambios())">
                <i class="bi bi-save me-2"></i> Guardar
            </button>
        </div>
    </div>
</div>

@code {
    protected override string ApiUrl => "bancos";
    protected override string PageUrl => "/configuracion/bancos";
}