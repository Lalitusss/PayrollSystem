@page "/configuracion/categorias/nuevo"
@page "/configuracion/categorias/editar/{Id:int}"
@using Payroll.Services.DTOs
@using Microsoft.AspNetCore.Components.Forms
@using System.Web
@inherits BaseFormulario<CategoriaDto>
@inject NavigationManager Navigation

<div class="container mt-4">
    <div class="mb-4 d-flex justify-content-between align-items-center">
        <div>
            <button class="btn btn-sm btn-link text-decoration-none p-0 text-secondary" @onclick="VolverAConvenios">
                <i class="bi bi-arrow-left"></i> Volver a la Matriz de Convenios
            </button>
            <h3 class="fw-bold mt-2 text-dark">
                <i class="bi bi-folder-plus me-2 text-primary"></i>
                @(Id == 0 ? "Nueva Categoría" : $"Editar Categoría: {Modelo?.Nombre}")
            </h3>
        </div>
        
        @if (Id == 0 && Modelo?.ConvenioId != 0)
        {
            <span class="badge bg-info-subtle text-info border border-info-subtle px-3 py-2 rounded-pill">
                <i class="bi bi-info-circle me-1"></i> Vinculando al Convenio #@Modelo?.ConvenioId
            </span>
        }
    </div>

    @if (Modelo == null)
    {
        <div class="text-center mt-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Cargando formulario...</p>
        </div>
    }
    else
    {
        <EditForm Model="Modelo" OnValidSubmit="GuardarYRegresar">
            <DataAnnotationsValidator />
            
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body p-4">
                    <div class="row g-4">
                        @* CAMPO: NOMBRE *@
                        <div class="col-md-8">
                            <label class="form-label fw-bold small text-uppercase text-muted">Nombre de la Categoría</label>
                            <InputText class="form-control form-control-lg border-2"
                                       @bind-Value="Modelo.Nombre"
                                       placeholder="Ej: Administrativos, Maestranza, Vendedores..." />
                            <ValidationMessage For="@(() => Modelo.Nombre)" class="text-danger small fw-bold" />
                        </div>

                        @* CAMPO: CONVENIO (Visualización) *@
                        <div class="col-md-4">
                            <label class="form-label fw-bold small text-uppercase text-muted">ID Convenio</label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-light border-2"><i class="bi bi-hash"></i></span>
                                <input type="text" class="form-control bg-light border-2" value="@Modelo.ConvenioId" disabled />
                            </div>
                        </div>
                    </div>
                    
                    <div class="text-end mt-5 border-top pt-4">
                        <button type="button" class="btn btn-outline-secondary px-4 me-2 border-2" @onclick="VolverAConvenios">
                            <i class="bi bi-x-lg me-1"></i> Cancelar
                        </button>
                        <button type="submit" class="btn btn-primary btn-lg px-5 shadow border-0">
                            <i class="bi bi-check2-all me-2"></i> @(Id == 0 ? "Crear Categoría" : "Guardar Cambios")
                        </button>
                    </div>
                </div>
            </div>
        </EditForm>
    }
</div>

@code {
    protected override string ApiUrl => "categorias";
    protected override string PageUrl => "/configuracion/convenios";

    // Usamos OnParametersSetAsync porque se ejecuta DESPUÉS de OnInitialized
    // y es donde Blazor termina de asentar los valores del Modelo.
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        if (Id == 0)
        {
            // 1. Forzamos la creación si la base lo dejó nulo
            if (Modelo == null) Modelo = new CategoriaDto();

            // 2. Capturamos el ID de la URL
            var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
            var cid = query.Get("convenioId");

            if (!string.IsNullOrEmpty(cid) && int.TryParse(cid, out int convenioId))
            {
                // 3. Asignación directa al campo del Modelo
                Modelo.ConvenioId = convenioId;
                
                // 4. Log de consola para que verifiques en F12
                Console.WriteLine($"[DEBUG] ConvenioId asignado con éxito: {Modelo.ConvenioId}");
                
                // 5. Notificamos al UI del cambio
                StateHasChanged();
            }
        }
    }

    private async Task GuardarYRegresar()
    {
        if (Modelo == null || Modelo.ConvenioId == 0)
        {
            // Opcional: podrías mostrar una alerta aquí
            return;
        }

        await base.Guardar();
    }

    private void VolverAConvenios() => Navigation.NavigateTo(PageUrl);
}