@page "/configuracion/categorias/nuevo"
@page "/configuracion/categorias/editar/{Id:int}"
@inherits BaseFormulario<CategoriaDto>

<div class="mb-4">
    <button class="btn btn-link text-decoration-none p-0" @onclick="Cancelar">
        <i class="bi bi-arrow-left"></i> Volver a la lista
    </button>
    <h3 class="fw-bold mt-2">@(Id == 0 ? "Nueva Categoría" : $"Editar Categoría: {Modelo.Nombre}")</h3>
</div>

@* --- BLOQUE 1: DATOS BÁSICOS (Guardado General) --- *@
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-4">
        <h5 class="fw-bold mb-3 text-secondary">Datos Generales</h5>
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label fw-bold">Nombre de Categoría</label>
                <input type="text" class="form-control" @bind="Modelo.Nombre" />
            </div>
            
            <div class="col-md-4">
                <label class="form-label fw-bold">Cargo</label>
                <select class="form-select" @bind="Modelo.CargoId">
                    <option value="0">-- Seleccione --</option>
                    @foreach (var car in cargos)
                    {
                        <option value="@car.Id">@car.Nombre</option>
                    }
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label fw-bold">Sueldo Básico ($)</label>
                <input type="number" step="0.01" class="form-control" @bind="Modelo.SueldoBasico" />
            </div>
        </div>
        
        <div class="text-end mt-4">
            <button class="btn btn-primary px-4" @onclick="base.Guardar" disabled="@(!HuboCambios())">
                <i class="bi bi-check-circle me-2"></i> Guardar Datos Básicos
            </button>
        </div>
    </div>
</div>

@* --- BLOQUE 2: VÍNCULO CON CONCEPTOS (Guardado de Relación) --- *@
@if (Id != 0)
{
    <div class="card shadow-sm border-0 border-top border-primary border-5">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0 text-primary">Vínculo con Conceptos Salariales</h5>
            
            <div class="d-flex gap-2">
                <select class="form-select form-select-sm" @bind="conceptoIdParaAgregar" style="width: 250px;">
                    <option value="0">-- Buscar Concepto --</option>
                    @foreach (var c in todosLosConceptos.Where(x => !Modelo.Conceptos.Any(m => m.Id == x.Id)))
                    {
                        <option value="@c.Id">@c.Nombre</option>
                    }
                </select>
                <button class="btn btn-success btn-sm" @onclick="AgregarConcepto" disabled="@(conceptoIdParaAgregar == 0)">
                    <i class="bi bi-plus-lg"></i>
                </button>
            </div>
        </div>

        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Concepto</th>
                        <th>Tipo</th>
                        <th class="text-end pe-4">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var concepto in Modelo.Conceptos)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">@concepto.Nombre</td>
                            <td><span class="badge bg-light text-dark border">@concepto.TipoNombre</span></td>
                            <td class="text-end pe-4">
                                <button class="btn btn-sm text-danger" @onclick="() => Modelo.Conceptos.Remove(concepto)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-light text-end py-3">
            <button class="btn btn-outline-primary" @onclick="GuardarConceptos">
                <i class="bi bi-link-45deg me-2"></i> Actualizar Vínculos de Conceptos
            </button>
        </div>
    </div>
}

@code {
    protected override string ApiUrl => "categorias";
    protected override string PageUrl => "/configuracion/categorias";

    private List<CargoDto> cargos = new();
    private List<ConceptoDto> todosLosConceptos = new();
    private int conceptoIdParaAgregar;

    protected override async Task OnInitializedAsync()
    {
        cargos = await Http.GetFromJsonAsync<List<CargoDto>>("api/cargos") ?? new();
        todosLosConceptos = await Http.GetFromJsonAsync<List<ConceptoDto>>("api/conceptos") ?? new();
        await base.OnInitializedAsync();
    }

    private void AgregarConcepto()
    {
        var concepto = todosLosConceptos.FirstOrDefault(c => c.Id == conceptoIdParaAgregar);
        if (concepto != null)
        {
            Modelo.Conceptos.Add(concepto);
            conceptoIdParaAgregar = 0;
        }
    }

    private async Task GuardarConceptos()
    {
        // Extraemos solo los IDs de los conceptos seleccionados
        var idsParaEnviar = Modelo.Conceptos.Select(c => c.Id).ToList();

        var response = await Http.PostAsJsonAsync($"api/categorias/{Id}/conceptos", idsParaEnviar);
        if (response.IsSuccessStatusCode)
            await JS.InvokeVoidAsync("Swal.fire", "Éxito", "Vínculos actualizados correctamente", "success");
    }
}