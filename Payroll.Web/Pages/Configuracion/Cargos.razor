@page "/configuracion/cargos"
@inherits BaseListado<CargoDto>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-dark">Cargos</h2>
    <button class="btn btn-primary shadow-sm" @onclick="IrANuevo">
        <i class="bi bi-plus-circle me-2"></i> Nuevo Cargo
    </button>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Nombre del Cargo</th>
                        <th>Convenio Asociado</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>               
            </table>
        </div>
    </div>
</div>

@code {
    protected override string PageUrl => "/configuracion/cargos";
}