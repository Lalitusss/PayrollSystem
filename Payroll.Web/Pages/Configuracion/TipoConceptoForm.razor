@page "/configuracion/tiposconceptos/nuevo"
@page "/configuracion/tiposconceptos/editar/{Id:int}"
@inherits BaseFormulario<TipoConceptoDto>

<div class="mb-4">
    <button class="btn btn-link text-decoration-none p-0" @onclick="Cancelar">
        <i class="bi bi-arrow-left"></i> Volver a la lista
    </button>
    <h3 class="fw-bold mt-2">@(Id == 0 ? "Nuevo Tipo de Concepto" : "Editar Tipo de Concepto")</h3>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <div class="row g-3">
            <div class="col-md-8">
                <label class="form-label fw-bold">Nombre del Tipo</label>
                <input type="text" class="form-control" 
                       @bind="Modelo.Nombre" 
                       @bind:event="oninput" 
                       placeholder="Ej: Retenciones" />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-bold">Color Identificador</label>
                <div class="d-flex gap-2">
                    @* El input color sincroniza el selector visual *@
                    <input type="color" class="form-control form-control-color" 
                           @bind="Modelo.ColorHex" 
                           @bind:event="oninput"
                           title="Elegí un color" />
                    
                    @* El input text permite escribir el hexadecimal *@
                    <input type="text" class="form-control font-monospace" 
                           @bind="Modelo.ColorHex" 
                           @bind:event="oninput"
                           placeholder="#000000" />
                </div>
            </div>
        </div>

        <div class="text-end mt-4">
            <button class="btn btn-light me-2" @onclick="Cancelar">Cancelar</button>
            <button class="btn btn-primary px-5" 
                    @onclick="Guardar" 
                    disabled="@(!HuboCambios())">
                <i class="bi bi-save me-2"></i> Guardar
            </button>
        </div>
    </div>
</div>

@code {
    protected override string ApiUrl => "tiposconceptos";
    protected override string PageUrl => "/configuracion/tiposconceptos";

    protected override void OnInitialized()
    {
        // Color por defecto para nuevos registros
        if (Id == 0 && string.IsNullOrEmpty(Modelo.ColorHex))
        {
            Modelo.ColorHex = "#6c757d";
        }
    }
}