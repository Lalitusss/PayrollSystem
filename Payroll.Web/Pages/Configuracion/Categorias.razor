@page "/configuracion/categorias"
@using System.Globalization
@inherits BaseListado<CategoriaDto>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-dark">Categorías</h2>
    <button class="btn btn-primary shadow-sm" @onclick="IrANuevo">
        <i class="bi bi-plus-circle me-2"></i> Nueva Categoría
    </button>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Nombre</th>
                        <th>Cargo Relacionado</th>
                        <th>Sueldo Básico</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Lista == null)
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5">
                                <div class="spinner-border text-primary spinner-border-sm" role="status"></div>
                                <span class="ms-2">Cargando categorías...</span>
                            </td>
                        </tr>
                    }
                    else if (!Lista.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                No hay categorías registradas.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var c in Lista)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold">@c.Nombre</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(c.CargoNombre))
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3">
                                            @c.CargoNombre
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Sin asignar</span>
                                    }
                                </td>
                                <td class="fw-mono text-success">
                                    $ @c.SueldoBasico.ToString("N2", new System.Globalization.CultureInfo("es-AR"))
                                </td>
                                <td class="text-end pe-4">
                                    <button class="btn btn-sm btn-light border me-1" @onclick="() => IrAEditar(c.Id)">
                                        <i class="bi bi-pencil text-primary"></i>
                                    </button>
                                    <button class="btn btn-sm btn-light border" @onclick="() => Eliminar(c.Id)">
                                        <i class="bi bi-trash text-danger"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    protected override string PageUrl => "/configuracion/categorias";
}